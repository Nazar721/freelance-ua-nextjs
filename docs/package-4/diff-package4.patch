+    const src = tag.match(/\bsrc="([^"]+)"/)?.[1];
+    const poster = tag.match(/\bposter="([^"]+)"/)?.[1];
+    const srcset = tag.match(/\bsrcset="([^"]+)"/)?.[1];
+    if (src) raws.push(src);
+    if (poster) raws.push(poster);
+    if (srcset) {
